{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 360,
  "data": {
    "url": "data/ses_study_area_2025.csv",
    "format": {
      "type": "csv",
      "parse": {
        "value": "number",
        "gap": "number",
        "national": "number",
        "overall": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.measure != 'Overall Educational Experience'"
    },
    {
      "filter": "datum.level == level_select"
    },
    {
      "calculate": "indexof([\"Medicine\", \"Veterinary science\", \"Rehabilitation\", \"Business and management\", \"Humanities and culture\", \"Nursing\"], datum.study_area_short) >= 0",
      "as": "highlight"
    },
    {
      "calculate": "datum.study_area == pick ? (datum.highlight ? datum.study_area_short : 'Selected') : ((pick == 'All' && datum.highlight) ? datum.study_area_short : 'Other')",
      "as": "series"
    }
  ],
  "params": [
    {
      "name": "level_select",
      "value": "Undergraduate",
      "bind": {
        "input": "radio",
        "options": [
          "Undergraduate",
          "Postgraduate"
        ],
        "labels": [
          "Undergraduate",
          "Postgraduate coursework"
        ],
        "name": "Level of study: "
      }
    },
    {
      "name": "pick",
      "value": "All",
      "bind": {
        "input": "select",
        "options": [
          "All",
          "Agriculture and environmental studies",
          "Architecture and built environment",
          "Business and management",
          "Communications",
          "Computing and information systems",
          "Creative arts",
          "Dentistry",
          "Engineering",
          "Health services and support",
          "Humanities, culture and social sciences",
          "Law and paralegal studies",
          "Medicine",
          "Nursing",
          "Pharmacy",
          "Psychology",
          "Rehabilitation",
          "Science and mathematics",
          "Social work",
          "Teacher education",
          "Tourism, hospitality, personal services, sport and recreation",
          "Veterinary science"
        ],
        "name": "Highlight a study area: ",
        "labels": [
          "All six highlighted",
          "Agriculture and environment",
          "Architecture and building",
          "Business and management",
          "Communications",
          "Computing and IT",
          "Creative arts",
          "Dentistry",
          "Engineering",
          "Health services",
          "Humanities and social sciences",
          "Law and paralegal",
          "Medicine",
          "Nursing",
          "Pharmacy",
          "Psychology",
          "Rehabilitation",
          "Science and mathematics",
          "Social work",
          "Teacher education",
          "Tourism, hospitality and sport",
          "Veterinary science"
        ]
      }
    }
  ],
  "encoding": {
    "x": {
      "field": "measure_short",
      "type": "nominal",
      "title": "Focus area measured by the survey",
      "sort": [
        "Overall experience",
        "Teaching quality",
        "Skills development",
        "Learning resources",
        "Student support",
        "Peer engagement"
      ],
      "scale": {
        "padding": 0.2
      },
      "axis": {
        "labelFontSize": 12,
        "grid": true,
        "gridColor": "#ECEFEF",
        "labelAngle": 0,
        "labelPadding": 8
      }
    },
    "y": {
      "field": "value",
      "type": "quantitative",
      "title": "% of students rating positively",
      "scale": {
        "domain": [
          0,
          100
        ]
      }
    },
    "detail": {
      "field": "study_area",
      "type": "nominal"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 1.5,
        "point": {
          "filled": true,
          "size": 25
        }
      },
      "encoding": {
        "color": {
          "field": "series",
          "type": "nominal",
          "scale": {
            "domain": [
              "Medicine",
              "Veterinary science",
              "Rehabilitation",
              "Business and management",
              "Humanities and culture",
              "Nursing",
              "Selected",
              "Other"
            ],
            "range": [
              "#8C1C1C",
              "#A5653A",
              "#A552A5",
              "#167220",
              "#2121A5",
              "#46778C",
              "#CC2222",
              "#C4C9CA"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "title": null,
            "values": [
              "Medicine",
              "Veterinary science",
              "Rehabilitation",
              "Business and management",
              "Humanities and culture",
              "Nursing",
              "Other"
            ],
            "labelExpr": "datum.label == 'Other' ? 'Every other study area' : datum.label",
            "symbolType": "stroke",
            "symbolStrokeWidth": 3,
            "symbolSize": 160,
            "labelFontSize": 11.5,
            "columns": 4,
            "labelLimit": 200,
            "offset": 4,
            "rowPadding": 4
          }
        },
        "opacity": {
          "condition": [
            {
              "param": "hover",
              "value": 1,
              "empty": false
            },
            {
              "test": "datum.study_area == pick || (pick == 'All' && datum.highlight)",
              "value": 0.92
            }
          ],
          "value": 0.3
        },
        "tooltip": [
          {
            "field": "study_area",
            "type": "nominal",
            "title": "Study area"
          },
          {
            "field": "measure",
            "type": "nominal",
            "title": "Focus area"
          },
          {
            "field": "value",
            "type": "quantitative",
            "title": "% positive",
            "format": ".1f"
          }
        ],
        "strokeWidth": {
          "condition": [
            {
              "test": "datum.study_area == pick",
              "value": 3.2
            },
            {
              "test": "pick == 'All' && datum.highlight",
              "value": 2.2
            }
          ],
          "value": 1.1
        }
      },
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "fields": [
              "study_area"
            ],
            "on": "mouseover",
            "clear": "mouseout"
          }
        }
      ]
    },
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3,
        "color": "#4E5A5C",
        "point": {
          "filled": true,
          "size": 60,
          "color": "#4E5A5C"
        },
        "strokeDash": [
          5,
          3
        ]
      },
      "encoding": {
        "y": {
          "field": "national",
          "type": "quantitative"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.measure_short == 'Peer engagement'"
        },
        {
          "aggregate": [
            {
              "op": "max",
              "field": "national",
              "as": "national"
            }
          ],
          "groupby": [
            "measure_short"
          ]
        },
        {
          "calculate": "'National'",
          "as": "lbl"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "dy": 12,
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#4E5A5C"
      },
      "encoding": {
        "y": {
          "field": "national",
          "type": "quantitative"
        },
        "text": {
          "field": "lbl",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "grid": false,
      "domain": false,
      "ticks": false,
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#3F4650",
      "titleColor": "#3F4650",
      "gridColor": "#ECEFEF",
      "titlePadding": 10,
      "titleFontWeight": 600
    },
    "font": "Inter, system-ui, sans-serif",
    "legend": {
      "labelColor": "#3F4650",
      "titleColor": "#3F4650",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "symbolStrokeWidth": 0
    }
  },
  "padding": {
    "left": 5,
    "right": 16,
    "top": 5,
    "bottom": 5
  },
  "background": "transparent"
}