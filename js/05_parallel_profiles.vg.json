{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 360,
  "data": {
    "url": "data/ses_study_area_2025.csv",
    "format": {
      "type": "csv",
      "parse": {
        "value": "number",
        "gap": "number",
        "national": "number",
        "overall": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.measure != 'Overall Educational Experience'"
    },
    {
      "filter": "datum.level == level_select"
    }
  ],
  "params": [
    {
      "name": "level_select",
      "value": "Undergraduate",
      "bind": {
        "input": "radio",
        "options": [
          "Undergraduate",
          "Postgraduate"
        ],
        "labels": [
          "Undergraduate",
          "Postgraduate coursework"
        ],
        "name": "Level of study: "
      }
    },
    {
      "name": "pick",
      "value": "Medicine",
      "bind": {
        "input": "select",
        "options": [
          "Agriculture and environmental studies",
          "Architecture and built environment",
          "Business and management",
          "Communications",
          "Computing and information systems",
          "Creative arts",
          "Dentistry",
          "Engineering",
          "Health services and support",
          "Humanities, culture and social sciences",
          "Law and paralegal studies",
          "Medicine",
          "Nursing",
          "Pharmacy",
          "Psychology",
          "Rehabilitation",
          "Science and mathematics",
          "Social work",
          "Teacher education",
          "Tourism, hospitality, personal services, sport and recreation",
          "Veterinary science"
        ],
        "name": "Highlight a study area: ",
        "labels": [
          "Agriculture and environment",
          "Architecture and building",
          "Business and management",
          "Communications",
          "Computing and IT",
          "Creative arts",
          "Dentistry",
          "Engineering",
          "Health services",
          "Humanities and social sciences",
          "Law and paralegal",
          "Medicine",
          "Nursing",
          "Pharmacy",
          "Psychology",
          "Rehabilitation",
          "Science and mathematics",
          "Social work",
          "Teacher education",
          "Tourism, hospitality and sport",
          "Veterinary science"
        ]
      }
    }
  ],
  "encoding": {
    "x": {
      "field": "measure_short",
      "type": "nominal",
      "title": "Focus area measured by the survey",
      "sort": [
        "Overall experience",
        "Teaching quality",
        "Skills development",
        "Learning resources",
        "Student support",
        "Peer engagement"
      ],
      "scale": {
        "padding": 0.2
      },
      "axis": {
        "labelFontSize": 12,
        "grid": true,
        "gridColor": "#dcdcdc",
        "labelAngle": 0,
        "labelPadding": 8
      }
    },
    "y": {
      "field": "value",
      "type": "quantitative",
      "title": "% of students rating positively",
      "scale": {
        "domain": [
          30,
          95
        ]
      }
    },
    "detail": {
      "field": "study_area",
      "type": "nominal"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 1.5,
        "point": {
          "filled": true,
          "size": 25
        }
      },
      "encoding": {
        "color": {
          "condition": [
            {
              "test": "datum.study_area == pick",
              "value": "#173F5F"
            },
            {
              "param": "hover",
              "value": "#173F5F",
              "empty": false
            }
          ],
          "value": "#BFCBCB"
        },
        "opacity": {
          "condition": [
            {
              "test": "datum.study_area == pick",
              "value": 1
            },
            {
              "param": "hover",
              "value": 1,
              "empty": false
            }
          ],
          "value": 0.3
        },
        "tooltip": [
          {
            "field": "study_area",
            "type": "nominal",
            "title": "Study area"
          },
          {
            "field": "measure",
            "type": "nominal",
            "title": "Focus area"
          },
          {
            "field": "value",
            "type": "quantitative",
            "title": "% positive",
            "format": ".1f"
          }
        ],
        "strokeWidth": {
          "condition": {
            "test": "datum.study_area == pick",
            "value": 3.5
          },
          "value": 1.2
        }
      },
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "fields": [
              "study_area"
            ],
            "on": "mouseover",
            "clear": "mouseout"
          }
        }
      ]
    },
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3,
        "color": "#7E8A8C",
        "point": {
          "filled": true,
          "size": 60,
          "color": "#7E8A8C"
        },
        "strokeDash": [
          5,
          3
        ]
      },
      "encoding": {
        "y": {
          "field": "national",
          "type": "quantitative"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.measure_short == 'Peer engagement' && datum.study_area == pick"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "dy": -6,
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#173F5F"
      },
      "encoding": {
        "text": {
          "field": "study_area_short",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.measure_short == 'Peer engagement'"
        },
        {
          "aggregate": [
            {
              "op": "max",
              "field": "national",
              "as": "national"
            }
          ],
          "groupby": [
            "measure_short"
          ]
        },
        {
          "calculate": "'National'",
          "as": "lbl"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "dy": 12,
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#5F6B6D"
      },
      "encoding": {
        "y": {
          "field": "national",
          "type": "quantitative"
        },
        "text": {
          "field": "lbl",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "grid": false,
      "domain": false,
      "ticks": false,
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#3f4650",
      "titleColor": "#3f4650",
      "gridColor": "#ECEFEF",
      "titlePadding": 10,
      "titleFontWeight": 600
    },
    "font": "Inter, system-ui, sans-serif",
    "legend": {
      "labelColor": "#3f4650",
      "titleColor": "#3f4650",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "symbolStrokeWidth": 0
    }
  },
  "padding": {
    "left": 5,
    "right": 125,
    "top": 5,
    "bottom": 5
  }
}
