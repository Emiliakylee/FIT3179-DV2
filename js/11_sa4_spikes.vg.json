{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 330,
  "padding": {
    "left": 5,
    "right": 5,
    "top": 5,
    "bottom": 16
  },
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -134,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/au_sa4.topojson",
        "format": {
          "type": "topojson",
          "feature": "SA4_2021_AUST_GDA2020"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f7f8f8",
        "stroke": "#e3e7e7",
        "strokeWidth": 0.4
      }
    },
    {
      "data": {
        "url": "data/au_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "STE_2021_AUST_GDA2020"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#cdd6d6",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/international_by_sa4_2025.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lat": "number",
            "lon": "number",
            "enrolments": "number"
          }
        }
      },
      "transform": [
        {
          "calculate": "datum.lat + datum.enrolments * 0.00006",
          "as": "lat_top"
        }
      ],
      "mark": {
        "type": "rule",
        "opacity": 0.85,
        "strokeCap": "round",
        "strokeWidth": 2.2
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "lon"
        },
        "latitude2": {
          "field": "lat_top"
        },
        "color": {
          "field": "enrolments",
          "type": "quantitative",
          "title": "International students",
          "scale": {
            "scheme": "blues",
            "domain": [
              0,
              110000
            ]
          },
          "legend": {
            "orient": "top-left",
            "gradientLength": 130,
            "format": ",.0f",
            "titleFontSize": 11,
            "labelFontSize": 10,
            "direction": "horizontal",
            "title": "International students"
          }
        },
        "tooltip": [
          {
            "field": "sa4_name",
            "type": "nominal",
            "title": "Region"
          },
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "enrolments",
            "type": "quantitative",
            "title": "International students",
            "format": ","
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/international_by_sa4_2025.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lat": "number",
            "lon": "number",
            "enrolments": "number"
          }
        }
      },
      "mark": {
        "type": "circle",
        "color": "#3D6E9E",
        "size": 14,
        "opacity": 0.7
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "url": "data/international_by_sa4_2025.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lat": "number",
            "lon": "number",
            "enrolments": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.enrolments > 90000"
        },
        {
          "calculate": "datum.lat + datum.enrolments * 0.00006",
          "as": "lat_top"
        },
        {
          "calculate": "datum.sa4_name + '  ' + format(datum.enrolments, ',')",
          "as": "tag"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "dx": 0,
        "dy": -8,
        "fontSize": 11,
        "color": "#173F5F",
        "fontWeight": "bold"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat_top",
          "type": "quantitative"
        },
        "text": {
          "field": "tag",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Inter, system-ui, sans-serif",
    "axis": {
      "labelColor": "#3f4650",
      "titleColor": "#3f4650",
      "gridColor": "#ECEFEF",
      "domain": false,
      "ticks": false,
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titlePadding": 10,
      "titleFontWeight": 600
    },
    "legend": {
      "labelColor": "#3f4650",
      "titleColor": "#3f4650",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "symbolStrokeWidth": 0
    }
  }
}
