{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "vconcat": [
    {
      "hconcat": [
        {
          "width": 550,
          "height": 520,
          "projection": {
            "type": "conicEqualArea",
            "parallels": [
              -18,
              -36
            ],
            "rotate": [
              -134,
              0
            ]
          },
          "title": {
            "text": "All of Australia",
            "fontSize": 13,
            "color": "#173F5F",
            "fontWeight": 600,
            "anchor": "start",
            "dy": -4
          },
          "layer": [
            {
              "data": {
                "url": "data/au_sa4.topojson",
                "format": {
                  "type": "topojson",
                  "feature": "SA4_2021_AUST_GDA2020"
                }
              },
              "mark": {
                "type": "geoshape",
                "fill": "#E4EAEA",
                "stroke": "#6B797A",
                "strokeWidth": 1.0
              }
            },
            {
              "data": {
                "url": "data/sa4_triangles.csv",
                "format": {
                  "type": "csv",
                  "parse": {
                    "lon": "number",
                    "lat": "number",
                    "enrolments": "number",
                    "vertex": "number",
                    "apex_lat": "number"
                  }
                }
              },
              "transform": [
                {
                  "filter": "datum.panel == 'nat'"
                },
                {
                  "filter": "true"
                }
              ],
              "mark": {
                "type": "line",
                "interpolate": "linear",
                "fill": "#3D6E9E",
                "fillOpacity": 0.9,
                "stroke": "#FFFFFF",
                "strokeWidth": 0.7,
                "strokeJoin": "round"
              },
              "encoding": {
                "longitude": {
                  "field": "lon",
                  "type": "quantitative"
                },
                "latitude": {
                  "field": "lat",
                  "type": "quantitative"
                },
                "detail": {
                  "field": "sa4_name",
                  "type": "nominal"
                },
                "order": {
                  "field": "vertex",
                  "type": "quantitative"
                }
              }
            },
            {
              "data": {
                "url": "data/sa4_triangles.csv",
                "format": {
                  "type": "csv",
                  "parse": {
                    "lon": "number",
                    "lat": "number",
                    "enrolments": "number",
                    "vertex": "number",
                    "apex_lat": "number"
                  }
                }
              },
              "transform": [
                {
                  "filter": "datum.panel == 'nat'"
                },
                {
                  "filter": "datum.vertex == 1"
                },
                {
                  "filter": "datum.enrolments >= 90000"
                },
                {
                  "calculate": "datum.sa4_name",
                  "as": "tag"
                }
              ],
              "mark": {
                "type": "text",
                "align": "right",
                "dx": -9,
                "dy": -3,
                "fontSize": 10.5,
                "fontWeight": 600,
                "color": "#173F5F"
              },
              "encoding": {
                "longitude": {
                  "field": "lon",
                  "type": "quantitative"
                },
                "latitude": {
                  "field": "apex_lat",
                  "type": "quantitative"
                },
                "text": {
                  "field": "tag",
                  "type": "nominal"
                }
              }
            },
            {
              "data": {
                "url": "data/sa4_triangles.csv",
                "format": {
                  "type": "csv",
                  "parse": {
                    "lon": "number",
                    "lat": "number",
                    "enrolments": "number",
                    "vertex": "number",
                    "apex_lat": "number"
                  }
                }
              },
              "transform": [
                {
                  "filter": "datum.panel == 'nat'"
                },
                {
                  "filter": "true"
                },
                {
                  "filter": "datum.vertex == 1"
                }
              ],
              "mark": {
                "type": "rule",
                "strokeWidth": 11,
                "opacity": 0.001,
                "color": "#3D6E9E",
                "strokeCap": "round"
              },
              "encoding": {
                "longitude": {
                  "field": "cx",
                  "type": "quantitative"
                },
                "latitude": {
                  "field": "base_lat",
                  "type": "quantitative"
                },
                "longitude2": {
                  "field": "cx"
                },
                "latitude2": {
                  "field": "apex_lat"
                },
                "tooltip": [
                  {
                    "field": "sa4_name",
                    "type": "nominal",
                    "title": "Region"
                  },
                  {
                    "field": "state",
                    "type": "nominal",
                    "title": "State"
                  },
                  {
                    "field": "enrolments",
                    "type": "quantitative",
                    "title": "International students",
                    "format": ","
                  }
                ]
              }
            }
          ]
        },
        {
          "width": 530,
          "height": 520,
          "projection": {
            "type": "conicEqualArea",
            "parallels": [
              -18,
              -36
            ],
            "rotate": [
              -134,
              0
            ]
          },
          "title": {
            "text": "Zoomed: New South Wales, Victoria and the ACT",
            "fontSize": 13,
            "color": "#173F5F",
            "fontWeight": 600,
            "anchor": "start",
            "dy": -4
          },
          "layer": [
            {
              "data": {
                "url": "data/au_sa4.topojson",
                "format": {
                  "type": "topojson",
                  "feature": "SA4_2021_AUST_GDA2020"
                }
              },
              "mark": {
                "type": "geoshape",
                "fill": "#E4EAEA",
                "stroke": "#6B797A",
                "strokeWidth": 1.0
              },
              "transform": [
                {
                  "filter": "indexof(['New South Wales','Victoria','Australian Capital Territory'], datum.properties.STE_NAME21) >= 0"
                }
              ]
            },
            {
              "data": {
                "url": "data/sa4_triangles.csv",
                "format": {
                  "type": "csv",
                  "parse": {
                    "lon": "number",
                    "lat": "number",
                    "enrolments": "number",
                    "vertex": "number",
                    "apex_lat": "number"
                  }
                }
              },
              "transform": [
                {
                  "filter": "datum.panel == 'det'"
                },
                {
                  "filter": "indexof(['NSW','VIC','ACT'], datum.state) >= 0"
                }
              ],
              "mark": {
                "type": "line",
                "interpolate": "linear",
                "fill": "#3D6E9E",
                "fillOpacity": 0.9,
                "stroke": "#FFFFFF",
                "strokeWidth": 0.7,
                "strokeJoin": "round"
              },
              "encoding": {
                "longitude": {
                  "field": "lon",
                  "type": "quantitative"
                },
                "latitude": {
                  "field": "lat",
                  "type": "quantitative"
                },
                "detail": {
                  "field": "sa4_name",
                  "type": "nominal"
                },
                "order": {
                  "field": "vertex",
                  "type": "quantitative"
                }
              }
            },
            {
              "data": {
                "url": "data/sa4_triangles.csv",
                "format": {
                  "type": "csv",
                  "parse": {
                    "lon": "number",
                    "lat": "number",
                    "enrolments": "number",
                    "vertex": "number",
                    "apex_lat": "number"
                  }
                }
              },
              "transform": [
                {
                  "filter": "datum.panel == 'det'"
                },
                {
                  "filter": "indexof(['NSW','VIC','ACT'], datum.state) >= 0"
                },
                {
                  "filter": "datum.vertex == 1"
                },
                {
                  "filter": "datum.enrolments >= 14000"
                },
                {
                  "calculate": "datum.sa4_name",
                  "as": "tag"
                },
                {
                  "calculate": "datum.sa4_name == 'Melbourne - Inner East' ? -36.30 : datum.sa4_name == 'Melbourne - South East' ? -37.00 : datum.sa4_name == 'Melbourne - Inner South' ? -37.70 : datum.apex_lat",
                  "as": "label_y"
                }
              ],
              "mark": {
                "type": "text",
                "align": "right",
                "dx": -9,
                "dy": -3,
                "fontSize": 11,
                "fontWeight": 600,
                "color": "#173F5F"
              },
              "encoding": {
                "longitude": {
                  "field": "lon",
                  "type": "quantitative"
                },
                "latitude": {
                  "field": "label_y",
                  "type": "quantitative"
                },
                "text": {
                  "field": "tag",
                  "type": "nominal"
                }
              }
            },
            {
              "data": {
                "url": "data/sa4_triangles.csv",
                "format": {
                  "type": "csv",
                  "parse": {
                    "lon": "number",
                    "lat": "number",
                    "enrolments": "number",
                    "vertex": "number",
                    "apex_lat": "number"
                  }
                }
              },
              "transform": [
                {
                  "filter": "datum.panel == 'det'"
                },
                {
                  "filter": "indexof(['NSW','VIC','ACT'], datum.state) >= 0"
                },
                {
                  "filter": "datum.vertex == 1"
                }
              ],
              "mark": {
                "type": "rule",
                "strokeWidth": 11,
                "opacity": 0.001,
                "color": "#3D6E9E",
                "strokeCap": "round"
              },
              "encoding": {
                "longitude": {
                  "field": "cx",
                  "type": "quantitative"
                },
                "latitude": {
                  "field": "base_lat",
                  "type": "quantitative"
                },
                "longitude2": {
                  "field": "cx"
                },
                "latitude2": {
                  "field": "apex_lat"
                },
                "tooltip": [
                  {
                    "field": "sa4_name",
                    "type": "nominal",
                    "title": "Region"
                  },
                  {
                    "field": "state",
                    "type": "nominal",
                    "title": "State"
                  },
                  {
                    "field": "enrolments",
                    "type": "quantitative",
                    "title": "International students",
                    "format": ","
                  }
                ]
              }
            }
          ]
        }
