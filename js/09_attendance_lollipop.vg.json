{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 300,
  "data": {
    "url": "data/ses_class_participation_2025.csv",
    "format": {
      "type": "csv",
      "parse": {
        "value": "number"
      }
    }
  },
  "params": [
    {
      "name": "measure_select",
      "value": "Teaching Quality and Engagement",
      "bind": {
        "input": "select",
        "options": [
          "Teaching Quality and Engagement",
          "Overall Educational Experience",
          "Skills Development",
          "Learning Resources",
          "Student Support and Services",
          "Peer Engagement"
        ],
        "name": "Measure: "
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.measure == measure_select"
    }
  ],
  "encoding": {
    "y": {
      "field": "participation",
      "type": "nominal",
      "title": null,
      "sort": [
        "All on-campus",
        "Blended/hybrid",
        "All online"
      ],
      "axis": {
        "labelFontSize": 12,
        "labelLimit": 160
      }
    },
    "x": {
      "field": "value",
      "type": "quantitative",
      "title": "% rating positively",
      "scale": {
        "domain": [
          0,
          100
        ]
      }
    },
    "color": {
      "field": "level",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "Undergraduate",
          "Postgraduate"
        ],
        "range": [
          "#126F70",
          "#A8502A"
        ]
      },
      "legend": {
        "orient": "top",
        "direction": "horizontal",
        "title": null,
        "labelExpr": "datum.label == 'Postgraduate' ? 'Postgraduate coursework' : datum.label",
        "symbolType": "circle",
        "symbolSize": 150,
        "offset": 6,
        "labelFontSize": 12,
        "symbolOpacity": 1
      }
    },
    "yOffset": {
      "field": "level",
      "type": "nominal",
      "scale": {
        "paddingOuter": 0.3
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2,
        "opacity": 0.55,
        "point": false
      },
      "encoding": {
        "detail": {
          "field": "level",
          "type": "nominal"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 170,
        "opacity": 1
      },
      "encoding": {
        "tooltip": [
          {
            "field": "participation",
            "type": "nominal",
            "title": "Attendance"
          },
          {
            "field": "level",
            "type": "nominal",
            "title": "Level"
          },
          {
            "field": "measure",
            "type": "nominal",
            "title": "Measure"
          },
          {
            "field": "value",
            "type": "quantitative",
            "title": "% positive",
            "format": ".1f"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "grid": true,
      "gridColor": "#ECEFEF",
      "domain": false,
      "ticks": false,
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#3F4650",
      "titleColor": "#3F4650",
      "titlePadding": 10,
      "titleFontWeight": 600
    },
    "font": "Inter, system-ui, sans-serif",
    "legend": {
      "labelColor": "#3F4650",
      "titleColor": "#3F4650",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "symbolStrokeWidth": 0
    }
  },
  "background": "transparent"
}