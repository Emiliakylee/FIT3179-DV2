{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 620,
  "padding": {
    "left": 5,
    "right": 60,
    "top": 5,
    "bottom": 5
  },
  "data": {
    "url": "data/ses_study_area_2025.csv",
    "format": {
      "type": "csv",
      "parse": {
        "value": "number",
        "gap": "number",
        "national": "number",
        "overall": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.measure == 'Overall Educational Experience'"
    },
    {
      "calculate": "indexof([\"Medicine\", \"Veterinary science\", \"Rehabilitation\", \"Business and management\", \"Humanities and culture\", \"Nursing\"], datum.study_area_short) >= 0",
      "as": "highlight"
    },
    {
      "calculate": "indexof([\"Humanities and culture\", \"Nursing\", \"Communications\", \"Business and management\", \"Social work\", \"Veterinary science\", \"Rehabilitation\", \"Medicine\", \"Dentistry\"], datum.study_area_short) >= 0",
      "as": "labelled"
    },
    {
      "calculate": "datum.highlight ? datum.study_area_short : 'Other study areas'",
      "as": "series"
    },
    {
      "calculate": "datum.level == 'Undergraduate' ? datum.value : null",
      "as": "_ug"
    },
    {
      "calculate": "datum.level == 'Postgraduate' ? datum.value : null",
      "as": "_pg"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "_ug",
          "as": "ug_value"
        },
        {
          "op": "max",
          "field": "_pg",
          "as": "pg_value"
        }
      ],
      "groupby": [
        "study_area"
      ]
    }
  ],
  "encoding": {
    "x": {
      "field": "level",
      "type": "nominal",
      "title": null,
      "sort": [
        "Undergraduate",
        "Postgraduate"
      ],
      "scale": {
        "padding": 0.3
      },
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 12,
        "labelPadding": 8,
        "labelExpr": "datum.label == 'Postgraduate' ? 'Postgraduate coursework' : datum.label",
        "labelLimit": 200
      }
    },
    "y": {
      "field": "value",
      "type": "quantitative",
      "title": "% rating positively",
      "scale": {
        "domain": [
          0,
          100
        ]
      }
    },
    "detail": {
      "field": "study_area",
      "type": "nominal"
    },
    "color": {
      "field": "series",
      "type": "nominal",
      "scale": {
        "domain": [
          "Medicine",
          "Veterinary science",
          "Rehabilitation",
          "Business and management",
          "Humanities and culture",
          "Nursing",
          "Other study areas"
        ],
        "range": [
          "#8C1C1C",
          "#A5653A",
          "#A552A5",
          "#167220",
          "#2121A5",
          "#46778C",
          "#C4C9CA"
        ]
      },
      "legend": null
    }
  },
  "layer": [
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "fields": [
              "study_area"
            ],
            "on": "mouseover",
            "clear": "mouseout"
          }
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 2,
        "point": {
          "filled": true,
          "size": 150
        }
      },
      "encoding": {
        "opacity": {
          "condition": [
            {
              "param": "hover",
              "value": 1,
              "empty": false
            },
            {
              "test": "datum.highlight",
              "value": 0.95
            }
          ],
          "value": 0.5
        },
        "strokeWidth": {
          "condition": {
            "test": "datum.highlight",
            "value": 2.6
          },
          "value": 1.3
        },
        "tooltip": [
          {
            "field": "study_area",
            "type": "nominal",
            "title": "Study area"
          },
          {
            "field": "ug_value",
            "type": "quantitative",
            "title": "Undergraduate",
            "format": ".1f"
          },
          {
            "field": "pg_value",
            "type": "quantitative",
            "title": "Postgraduate coursework",
            "format": ".1f"
          }
        ],
        "detail": {
          "field": "study_area",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.level == 'Postgraduate'"
        },
        {
          "filter": "datum.labelled"
        },
        {
          "calculate": "datum.study_area_short == \"Humanities and culture\" ? 84.9 : datum.study_area_short == \"Nursing\" ? 82.72 : datum.study_area_short == \"Communications\" ? 80.4 : datum.study_area_short == \"Business and management\" ? 78.22 : datum.study_area_short == \"Social work\" ? 76.05 : datum.study_area_short == \"Veterinary science\" ? 73.87 : datum.study_area_short == \"Rehabilitation\" ? 71.69 : datum.study_area_short == \"Medicine\" ? 69.51 : datum.study_area_short == \"Dentistry\" ? 64.0 : datum.value",
          "as": "label_y"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 11,
        "fontWeight": 600
      },
      "encoding": {
        "y": {
          "field": "label_y",
          "type": "quantitative"
        },
        "text": {
          "field": "study_area_short",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "grid": true,
      "gridColor": "#ECEFEF",
      "domain": false,
      "ticks": false,
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#3F4650",
      "titleColor": "#3F4650",
      "titlePadding": 10,
      "titleFontWeight": 600
    },
    "font": "Inter, system-ui, sans-serif",
    "legend": {
      "labelColor": "#3F4650",
      "titleColor": "#3F4650",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "symbolStrokeWidth": 0
    }
  },
  "background": "transparent"
}