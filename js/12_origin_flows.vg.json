          "type": "csv",
          "parse": {
            "lon": "number",
            "lat": "number",
            "students": "number",
            "step": "number"
          }
        }
      },
      "mark": {
        "type": "line",
        "stroke": "#3D6E9E",
        "strokeWidth": 10,
        "opacity": 0.001,
        "interpolate": "linear"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "order": {
          "field": "step",
          "type": "quantitative"
        },
        "detail": {
          "field": "country",
