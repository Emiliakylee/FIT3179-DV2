{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 360,
  "projection": {
    "type": "equalEarth",
    "rotate": [
      -95,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "values": [
          {
            "lon": 34,
            "lat": 34
          },
          {
            "lon": 156,
            "lat": -44
          }
        ]
      },
      "mark": {
        "type": "point",
        "opacity": 0
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "url": "data/world_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#EEF2F2",
        "stroke": "#6B797A",
        "strokeWidth": 1.0
      }
    },
    {
      "data": {
        "url": "data/flow_arcs.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lon": "number",
            "lat": "number",
            "students": "number",
            "step": "number"
          }
        }
      },
      "mark": {
        "type": "line",
        "color": "#3D6E9E",
        "opacity": 0.5,
