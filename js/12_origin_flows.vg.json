        "strokeCap": "round"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "order": {
          "field": "step",
          "type": "quantitative"
        },
        "detail": {
          "field": "country",
          "type": "nominal"
        },
        "strokeWidth": {
          "field": "students",
          "type": "quantitative",
          "title": "Students",
          "scale": {
            "type": "linear",
            "domain": [
              0,
              166525
            ],
            "range": [
              0,
              17
            ]
          },
          "legend": {
            "orient": "bottom-left",
            "format": ",.0f",
            "title": "Students",
            "values": [
              25000,
              75000,
              150000
            ],
            "symbolType": "stroke",
            "symbolSize": 2400,
            "labelOffset": 10,
            "rowPadding": 9
          }
        }
      }
    },
    {
      "data": {
        "url": "data/flow_arcs.csv",
