{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 360,
  "projection": {
    "type": "equalEarth",
    "rotate": [
      -95,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/world_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f1f4f4",
        "stroke": "white",
        "strokeWidth": 0.6
      }
    },
    {
      "data": {
        "url": "data/flows_top_countries_2024.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lat": "number",
            "lon": "number",
            "dest_lat": "number",
            "dest_lon": "number",
            "students": "number"
          }
        }
      },
      "mark": {
        "type": "rule",
        "color": "#D97745",
        "opacity": 0.55
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "dest_lon"
        },
        "latitude2": {
          "field": "dest_lat"
        },
        "strokeWidth": {
          "field": "students",
          "type": "quantitative",
          "title": "Students",
          "scale": {
            "type": "sqrt",
            "range": [
              0.8,
              14
            ]
          },
          "legend": {
            "orient": "bottom-left",
            "format": ",.0f"
          }
        },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "students",
            "type": "quantitative",
            "title": "Students",
            "format": ","
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/flows_top_countries_2024.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lat": "number",
            "lon": "number",
            "students": "number"
          }
        }
      },
      "mark": {
        "type": "circle",
        "color": "#A65A2E",
        "size": 28,
        "opacity": 0.9
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "url": "data/flows_top_countries_2024.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lat": "number",
            "lon": "number",
            "students": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.students > 20000"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "color": "#A65A2E",
        "dy": -10,
        "fontWeight": "bold"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "country",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Inter, system-ui, sans-serif",
    "axis": {
      "labelColor": "#6b6b6b",
      "titleColor": "#6b6b6b",
      "gridColor": "#ECEFEF",
      "domain": false,
      "ticks": false,
      "labelFontSize": 11,
      "titleFontSize": 11,
      "titlePadding": 8
    },
    "legend": {
      "labelColor": "#4a4a4a",
      "titleColor": "#6b6b6b",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "symbolStrokeWidth": 0
    }
  }
}
