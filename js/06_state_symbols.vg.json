{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 700,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -134,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/au_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "STE_2021_AUST_GDA2020"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#EEF2F2",
        "stroke": "#6B797A",
        "strokeWidth": 1.0
      }
    },
    {
      "data": {
        "url": "data/state_centroids.csv",
        "format": {
          "type": "csv",
          "parse": {
            "enrolments": "number",
            "lon": "number",
            "lat": "number"
          }
        }
      },
      "transform": [
        {
          "lookup": "state_name",
          "from": {
            "data": {
              "url": "data/enrolments_by_state_2024.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "enrolments": "number",
                  "overseas": "number",
                  "overseas_share": "number",
                  "universities": "number"
                }
              }
            },
            "key": "state_name",
            "fields": [
              "state",
              "enrolments",
              "overseas",
              "overseas_share",
              "universities"
            ]
          }
        }
      ],
      "mark": {
        "type": "circle",
        "color": "#373366",
        "opacity": 0.75,
        "stroke": "#FFFFFF",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "enrolments",
          "type": "quantitative",
          "title": "Students enrolled",
          "scale": {
            "type": "sqrt",
            "range": [
              50,
              1600
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "title": "Students enrolled",
            "titleOrient": "left",
            "values": [
              100000,
              300000,
              500000
            ],
            "format": ",.0f",
            "labelFontSize": 10,
            "titleFontSize": 10,
            "symbolFillColor": "#373366",
            "symbolOpacity": 0.75,
            "clipHeight": 46,
            "columnPadding": 14,
            "offset": 6
          }
        },
        "tooltip": [
          {
            "field": "state_name",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "enrolments",
            "type": "quantitative",
            "title": "Students",
            "format": ","
          },
          {
            "field": "overseas",
            "type": "quantitative",
            "title": "Overseas students",
            "format": ","
          },
          {
            "field": "overseas_share",
            "type": "quantitative",
            "title": "Overseas share (%)",
            "format": ".1f"
          },
          {
            "field": "universities",
            "type": "quantitative",
            "title": "Universities"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/state_centroids.csv",
        "format": {
          "type": "csv",
          "parse": {
            "enrolments": "number",
            "lon": "number",
            "lat": "number"
          }
        }
      },
      "transform": [
        {
          "lookup": "state_name",
          "from": {
            "data": {
              "url": "data/enrolments_by_state_2024.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "enrolments": "number"
                }
              }
            },
            "key": "state_name",
            "fields": [
              "state",
              "enrolments"
            ]
          }
        },
        {
          "filter": "indexof([\"Northern Territory\", \"Queensland\", \"Western Australia\", \"South Australia\", \"New South Wales\"], datum.state_name) >= 0"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 10.5,
        "fontWeight": "bold",
        "color": "#373366",
        "dy": -30,
        "align": "center"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "state_name",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "url": "data/state_centroids.csv",
        "format": {
          "type": "csv",
          "parse": {
            "enrolments": "number",
            "lon": "number",
            "lat": "number"
          }
        }
      },
      "transform": [
        {
          "lookup": "state_name",
          "from": {
            "data": {
              "url": "data/enrolments_by_state_2024.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "enrolments": "number"
                }
              }
            },
            "key": "state_name",
            "fields": [
              "state",
              "enrolments"
            ]
          }
        },
        {
          "filter": "indexof([\"Victoria\"], datum.state_name) >= 0"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 10.5,
        "fontWeight": "bold",
        "color": "#373366",
        "dx": -30,
        "dy": 2,
        "align": "right"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "state_name",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "url": "data/state_centroids.csv",
        "format": {
          "type": "csv",
          "parse": {
            "enrolments": "number",
            "lon": "number",
            "lat": "number"
          }
        }
      },
      "transform": [
        {
          "lookup": "state_name",
          "from": {
            "data": {
              "url": "data/enrolments_by_state_2024.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "enrolments": "number"
                }
              }
            },
            "key": "state_name",
            "fields": [
              "state",
              "enrolments"
            ]
          }
        },
        {
          "filter": "indexof([\"Australian Capital Territory\", \"Tasmania\"], datum.state_name) >= 0"
        },
        {
          "calculate": "datum.state_name == 'Australian Capital Territory' ? ['Australian Capital','Territory'] : datum.state_name",
          "as": "lbl"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 10.5,
        "fontWeight": "bold",
        "color": "#373366",
        "dx": 18,
        "dy": 2,
        "align": "left",
        "lineHeight": 12
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "lbl",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Inter, system-ui, sans-serif",
    "axis": {
      "labelColor": "#3F4650",
      "titleColor": "#3F4650",
      "gridColor": "#ECEFEF",
      "domain": false,
      "ticks": false,
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titlePadding": 10,
      "titleFontWeight": 600
    },
    "legend": {
      "labelColor": "#3F4650",
      "titleColor": "#3F4650",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "symbolStrokeWidth": 0
    }
  },
  "padding": {
    "left": 5,
    "right": 36,
    "top": 5,
    "bottom": 5
  },
  "background": "transparent"
}