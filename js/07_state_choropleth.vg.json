{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 360,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -134,
      0
    ]
  },
  "params": [
    {
      "name": "measure_select",
      "value": "Overall Educational Experience",
      "bind": {
        "input": "select",
        "options": [
          "Overall Educational Experience",
          "Teaching Quality and Engagement",
          "Skills Development",
          "Learning Resources",
          "Student Support and Services",
          "Peer Engagement"
        ],
        "name": "Measure: "
      }
    },
    {
      "name": "level_select",
      "value": "Undergraduate",
      "bind": {
        "input": "radio",
        "options": [
          "Undergraduate",
          "Postgraduate"
        ],
        "labels": [
          "Undergraduate",
          "Postgraduate coursework"
        ],
        "name": "Level of study: "
      }
    }
  ],
  "data": {
    "url": "data/ses_state_2025.csv",
    "format": {
      "type": "csv",
      "parse": {
        "value": "number",
        "gap": "number",
        "national": "number",
        "responses": "number",
        "universities": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.measure == measure_select"
    },
    {
      "filter": "datum.level == level_select"
    }
  ],
  "layer": [
    {
      "transform": [
        {
          "lookup": "state_name",
          "from": {
            "data": {
              "url": "data/au_states.topojson",
              "format": {
                "type": "topojson",
                "feature": "STE_2021_AUST_GDA2020"
              }
            },
            "key": "properties.STE_NAME21",
            "fields": [
              "type",
              "geometry"
            ]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#6B797A",
        "strokeWidth": 1.0
      },
      "encoding": {
        "color": {
          "field": "gap",
          "type": "quantitative",
          "title": "Points vs national",
          "scale": {
            "type": "linear",
            "clamp": true,
            "domain": [
              -12,
              -6,
              0,
              6,
              12
            ],
            "range": [
              "#762A83",
              "#AF8DC3",
              "#F7F7F7",
              "#7FBF7B",
              "#1B7837"
            ]
          },
          "legend": {
            "orient": "bottom-left",
            "gradientLength": 150,
            "format": "+d",
            "title": "Points vs national"
          }
        },
        "tooltip": [
          {
            "field": "state_name",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "value",
            "type": "quantitative",
            "title": "% positive",
            "format": ".1f"
          },
          {
            "field": "national",
            "type": "quantitative",
            "title": "National",
            "format": ".1f"
          },
          {
            "field": "gap",
            "type": "quantitative",
            "title": "Difference",
            "format": "+.1f"
          },
          {
            "field": "universities",
            "type": "quantitative",
            "title": "Universities"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "lookup": "state_name",
          "from": {
            "data": {
              "url": "data/state_label_points.csv",
              "format": {
                "type": "csv"
              }
            },
            "key": "state_name",
            "fields": [
              "lon",
              "lat"
            ]
          }
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#173F5F"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "value",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    },
    {
      "transform": [
        {
          "lookup": "state_name",
          "from": {
            "data": {
              "url": "data/state_label_points.csv",
              "format": {
                "type": "csv"
              }
            },
            "key": "state_name",
            "fields": [
              "lon",
              "lat"
            ]
          }
        },
        {
          "filter": "indexof([\"Northern Territory\", \"Queensland\", \"Western Australia\", \"South Australia\", \"New South Wales\", \"Victoria\"], datum.state_name) >= 0"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 10,
        "color": "#4E5A5C",
        "dy": 15,
        "align": "center"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "state_name",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "lookup": "state_name",
          "from": {
            "data": {
              "url": "data/state_label_points.csv",
              "format": {
                "type": "csv"
              }
            },
            "key": "state_name",
            "fields": [
              "lon",
              "lat"
            ]
          }
        },
        {
          "filter": "indexof([\"Australian Capital Territory\", \"Tasmania\"], datum.state_name) >= 0"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 10,
        "color": "#4E5A5C",
        "dx": 16,
        "dy": 15,
        "align": "left"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "state_name",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Inter, system-ui, sans-serif",
    "axis": {
      "labelColor": "#3F4650",
      "titleColor": "#3F4650",
      "gridColor": "#ECEFEF",
      "domain": false,
      "ticks": false,
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titlePadding": 10,
      "titleFontWeight": 600
    },
    "legend": {
      "labelColor": "#3F4650",
      "titleColor": "#3F4650",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "symbolStrokeWidth": 0
    }
  },
  "padding": {
    "left": 5,
    "right": 40,
    "top": 5,
    "bottom": 16
  },
  "background": "transparent"
}