{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "data/cohort_waffle.csv"
  },
  "columns": 2,
  "spacing": 40,
  "facet": {
    "field": "level_label",
    "type": "nominal",
    "title": null,
    "sort": [
      "Undergraduate",
      "Postgraduate coursework"
    ],
    "header": {
      "labelFontSize": 13,
      "labelFontWeight": "bold",
      "labelColor": "#1c1c1c",
      "labelAnchor": "start"
    }
  },
  "spec": {
    "width": 200,
    "height": 200,
    "mark": {
      "type": "square",
      "size": 300,
      "stroke": "white",
      "strokeWidth": 2
    },
    "encoding": {
      "x": {
        "field": "col",
        "type": "ordinal",
        "axis": null
      },
      "y": {
        "field": "row",
        "type": "ordinal",
        "axis": null,
        "scale": {
          "reverse": true
        }
      },
      "color": {
        "field": "cohort",
        "type": "nominal",
        "title": null,
        "scale": {
          "domain": [
            "Domestic",
            "International"
          ],
          "range": [
            "#D4DADF",
            "#3D6E9E"
          ]
        },
        "legend": {
          "orient": "bottom",
          "direction": "horizontal"
        }
      },
      "tooltip": [
        {
          "field": "level",
          "type": "nominal",
          "title": "Level"
        },
        {
          "field": "cohort",
          "type": "nominal",
          "title": "Cohort"
        }
      ]
    }
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Inter, system-ui, sans-serif",
    "axis": {
      "labelColor": "#3f4650",
      "titleColor": "#3f4650",
      "gridColor": "#ECEFEF",
      "domain": false,
      "ticks": false,
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titlePadding": 10,
      "titleFontWeight": 600
    },
    "legend": {
      "labelColor": "#3f4650",
      "titleColor": "#3f4650",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "symbolStrokeWidth": 0
    }
  }
}
