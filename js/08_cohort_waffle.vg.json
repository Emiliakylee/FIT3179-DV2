{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "data/cohort_waffle.csv",
    "format": {
      "type": "csv",
      "parse": {
        "index": "number"
      }
    }
  },
  "columns": 2,
  "spacing": 50,
  "facet": {
    "field": "level_label",
    "type": "nominal",
    "title": null,
    "sort": [
      "Undergraduate",
      "Postgraduate coursework"
    ],
    "header": {
      "labelFontSize": 13,
      "labelFontWeight": "bold",
      "labelColor": "#23282C",
      "labelAnchor": "start"
    }
  },
  "spec": {
    "width": 344,
    "height": 344,
    "layer": [
      {
        "mark": {
          "type": "square",
          "size": 1183,
          "stroke": "#FFFFFF",
          "strokeWidth": 2.5
        },
        "encoding": {
          "x": {
            "field": "col",
            "type": "ordinal",
            "axis": null
          },
          "y": {
            "field": "row",
            "type": "ordinal",
            "axis": null,
            "scale": {
              "reverse": true
            }
          },
          "color": {
            "field": "cohort",
            "type": "nominal",
            "title": null,
            "scale": {
              "domain": [
                "Domestic",
                "International"
              ],
              "range": [
                "#C4C9CA",
                "#3D6E9E"
              ]
            },
            "legend": {
              "orient": "bottom",
              "direction": "horizontal"
            }
          },
          "tooltip": [
            {
              "field": "level",
              "type": "nominal",
              "title": "Level"
            },
            {
              "field": "cohort",
              "type": "nominal",
              "title": "Cohort"
            }
          ]
        }
      },
      {
        "transform": [
          {
            "joinaggregate": [
              {
                "op": "count",
                "as": "n"
              }
            ],
            "groupby": [
              "level_label",
              "cohort"
            ]
          },
          {
            "calculate": "datum.cohort == 'International' ? (datum.level_label == 'Undergraduate' ? 14 : 24) : (datum.level_label == 'Undergraduate' ? 54 : 84)",
            "as": "anchor"
          },
          {
            "filter": "datum.index === datum.anchor"
          },
          {
            "calculate": "format(datum.n, 'd') + '%'",
            "as": "pct_label"
          }
        ],
        "mark": {
          "type": "text",
          "fontSize": 30,
          "fontWeight": 700,
          "baseline": "middle",
          "align": "center"
        },
        "encoding": {
          "x": {
            "field": "col",
            "type": "ordinal",
            "axis": null
          },
          "y": {
            "field": "row",
            "type": "ordinal",
            "axis": null,
            "scale": {
              "reverse": true
            }
          },
          "text": {
            "field": "pct_label",
            "type": "nominal"
          },
          "color": {
            "condition": {
              "test": "datum.cohort == 'International'",
              "value": "#FFFFFF"
            },
            "value": "#3A3F45"
          },
          "tooltip": null
        }
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Inter, system-ui, sans-serif",
    "axis": {
      "labelColor": "#3F4650",
      "titleColor": "#3F4650",
      "gridColor": "#ECEFEF",
      "domain": false,
      "ticks": false,
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titlePadding": 10,
      "titleFontWeight": 600
    },
    "legend": {
      "labelColor": "#3F4650",
      "titleColor": "#3F4650",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "symbolStrokeWidth": 0
    }
  },
  "background": "transparent"
}