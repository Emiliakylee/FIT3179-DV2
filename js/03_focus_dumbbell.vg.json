{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 260,
  "data": {
    "url": "data/ses_trend_2017_2025.csv",
    "format": {
      "type": "csv",
      "parse": {
        "value": "number",
        "year": "string"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.year == 2025"
    }
  ],
  "encoding": {
    "y": {
      "field": "measure",
      "type": "nominal",
      "title": null,
      "sort": [
        "Learning Resources",
        "Skills Development",
        "Teaching Quality and Engagement",
        "Overall Educational Experience",
        "Student Support and Services",
        "Peer Engagement"
      ],
      "axis": {
        "labelLimit": 240,
        "labelFontSize": 12,
        "labelLineHeight": 14,
        "labelExpr": "datum.label == 'Teaching Quality and Engagement' ? ['Teaching quality','and engagement'] : datum.label == 'Student Support and Services' ? ['Student support','and services'] : datum.label == 'Overall Educational Experience' ? ['Overall educational','experience'] : datum.label == 'Learning Resources' ? 'Learning resources' : datum.label == 'Skills Development' ? 'Skills development' : datum.label == 'Peer Engagement' ? 'Peer engagement' : datum.label"
      }
    }
  },
  "layer": [
    {
      "transform": [
        {
          "pivot": "level",
          "value": "value",
          "groupby": [
            "measure"
          ]
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#8E9899",
        "strokeWidth": 3.5
      },
      "encoding": {
        "x": {
          "field": "Undergraduate",
          "type": "quantitative",
          "title": "% rating positively",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": {
            "values": [
              0,
              20,
              40,
              60,
              80,
              100
            ]
          }
        },
        "x2": {
          "field": "Postgraduate"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 150,
        "opacity": 1
      },
      "encoding": {
        "x": {
          "field": "value",
          "type": "quantitative"
        },
        "color": {
          "field": "level",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Undergraduate",
              "Postgraduate"
            ],
            "range": [
              "#126F70",
              "#A8502A"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "labelExpr": "datum.label == 'Postgraduate' ? 'Postgraduate coursework' : datum.label"
          }
        },
        "tooltip": [
          {
            "field": "measure",
            "type": "nominal",
            "title": "Measure"
          },
          {
            "field": "level",
            "type": "nominal",
            "title": "Level"
          },
          {
            "field": "value",
            "type": "quantitative",
            "title": "% positive",
            "format": ".1f"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "grid": true,
      "gridColor": "#ECEFEF",
      "domain": false,
      "ticks": false,
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#3F4650",
      "titleColor": "#3F4650",
      "titlePadding": 10,
      "titleFontWeight": 600
    },
    "font": "Inter, system-ui, sans-serif",
    "legend": {
      "labelColor": "#3F4650",
      "titleColor": "#3F4650",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "symbolStrokeWidth": 0
    }
  },
  "background": "transparent",
  "padding": {
    "left": 5,
    "right": 10,
    "top": 5,
    "bottom": 5
  }
}