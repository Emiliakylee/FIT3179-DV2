{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 580,
  "data": {
    "url": "data/ses_study_area_2025.csv",
    "format": {
      "type": "csv",
      "parse": {
        "value": "number",
        "gap": "number",
        "national": "number",
        "overall": "number"
      }
    }
  },
  "params": [
    {
      "name": "level_select",
      "value": "Undergraduate",
      "bind": {
        "input": "radio",
        "options": [
          "Undergraduate",
          "Postgraduate"
        ],
        "labels": [
          "Undergraduate",
          "Postgraduate coursework"
        ],
        "name": "Level of study: "
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.level == level_select"
    }
  ],
  "encoding": {
    "x": {
      "field": "measure_short",
      "type": "nominal",
      "title": "Focus area measured by the survey",
      "sort": [
        "Overall experience",
        "Teaching quality",
        "Skills development",
        "Learning resources",
        "Student support",
        "Peer engagement"
      ],
      "axis": {
        "orient": "top",
        "labelAngle": 0,
        "labelFontSize": 12,
        "labelPadding": 8,
        "titleFontSize": 12,
        "titlePadding": 12
      }
    },
    "y": {
      "field": "study_area_short",
      "type": "nominal",
      "title": "Study area",
      "sort": [
        "Agriculture and environment",
        "Veterinary science",
        "Tourism and hospitality",
        "Rehabilitation",
        "Medicine",
        "Law and paralegal",
        "Health services",
        "Social work",
        "Psychology",
        "Teacher education",
        "Humanities and culture",
        "Creative arts",
        "Communications",
        "Science and mathematics",
        "Nursing",
        "Pharmacy",
        "Architecture and building",
        "Business and management",
        "Dentistry",
        "Engineering",
        "Computing and IT"
      ],
      "axis": {
        "labelLimit": 280,
        "labelFontSize": 12,
        "titleFontSize": 12
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#FFFFFF",
        "strokeWidth": 1.5
      },
      "encoding": {
        "color": {
          "field": "gap",
          "type": "quantitative",
          "title": "Points vs national result",
          "scale": {
            "type": "linear",
            "clamp": true,
            "domain": [
              -12,
              -6,
              0,
              6,
              12
            ],
            "range": [
              "#762A83",
              "#AF8DC3",
              "#F7F7F7",
              "#7FBF7B",
              "#1B7837"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "gradientLength": 220,
            "titleLimit": 320,
            "format": "+d",
            "title": "Points vs national result"
          }
        },
        "tooltip": [
          {
            "field": "study_area",
            "type": "nominal",
            "title": "Study area"
          },
          {
            "field": "measure",
            "type": "nominal",
            "title": "Focus area"
          },
          {
            "field": "value",
            "type": "quantitative",
            "title": "% rating positively",
            "format": ".1f"
          },
          {
            "field": "national",
            "type": "quantitative",
            "title": "National average",
            "format": ".1f"
          },
          {
            "field": "gap",
            "type": "quantitative",
            "title": "Difference",
            "format": "+.1f"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "domain": false,
      "ticks": false,
      "labelFontSize": 12,
      "labelColor": "#3F4650",
      "titleColor": "#3F4650",
      "gridColor": "#ECEFEF",
      "titleFontSize": 12,
      "titlePadding": 10,
      "titleFontWeight": 600
    },
    "font": "Inter, system-ui, sans-serif",
    "legend": {
      "labelColor": "#3F4650",
      "titleColor": "#3F4650",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "symbolStrokeWidth": 0
    }
  },
  "background": "transparent"
}